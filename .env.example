# c-review-ai 環境変数
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# Groq API Key（必須・無料で取得可能: https://console.groq.com）
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# 以下は docker-compose.yml で自動設定されるため通常変更不要
# DATABASE_URL=postgresql://creview:creview@postgres:5432/creview
# CHROMA_HOST=chromadb
# CHROMA_PORT=8100
